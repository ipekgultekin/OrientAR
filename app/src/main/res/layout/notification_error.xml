<?xml version="1.0" encoding="utf-8"?>
<!--
    Error notification — blocker, often with action buttons.
    Glass-card with red 3dp left border. Vertical layout: header (icon + title),
    optional description, optional 1-2 action buttons (end-aligned).
    SCRUM-107 Step 1. Inflated by NotificationManager.showError().
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_error"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Header row: icon + title -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_notification_error"
            app:tint="@color/orientar_primary" />

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Optional description -->
    <TextView
        android:id="@+id/notification_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Action button container; populated programmatically by NotificationManager. -->
    <LinearLayout
        android:id="@+id/notification_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
