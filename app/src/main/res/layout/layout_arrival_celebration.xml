<?xml version="1.0" encoding="utf-8"?>
<!--
    SCRUM-107 F7: arrival celebration overlay, F6-aligned.
    - Raw-hex colors migrated to @color/ tokens.
    - Stock ic_menu_myplaces success icon → ic_notification_check in a circular green badge.
    - "🎉" emoji removed.
    - Done button → bg_button_red_action (vibrant); Share log de-emphasized to a text button.
    - Two separate glass stat cards (TIME / DISTANCE) replace the single divided card.
    View IDs preserved (set in ArNavigationActivity.showArrivalCelebration + wired L1144-1152):
    ivArrivalIcon, tvArrivalDestination, tvArrivalTime, tvArrivalDistance,
    btnArrivalShareLog, btnArrivalClose.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutArrivalCelebration"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/glass_dark_solid"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <!-- Success check badge -->
    <FrameLayout
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:background="@drawable/bg_arrival_check_badge">

        <ImageView
            android:id="@+id/ivArrivalIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notification_check"
            android:contentDescription="@null"
            android:tint="@color/status_success" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvArrivalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/arrival_title"
        android:textColor="@color/text_white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Destination name -->
    <TextView
        android:id="@+id/tvArrivalDestination"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Destination Name"
        android:textColor="@color/text_white_secondary"
        android:textSize="18sp" />

    <!-- Two stat cards: TIME / DISTANCE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <!-- Time card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvArrivalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3:45"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TIME"
                android:textColor="@color/text_white_hint"
                android:textSize="11sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Distance card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvArrivalDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="250m"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="DISTANCE"
                android:textColor="@color/text_white_hint"
                android:textSize="11sp"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </LinearLayout>

    <!-- Primary: Done -->
    <Button
        android:id="@+id/btnArrivalClose"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_button_red_action"
        android:text="Done"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- De-emphasized: Share log (text button) -->
    <Button
        android:id="@+id/btnArrivalShareLog"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:text="Share log"
        android:textAllCaps="false"
        android:textColor="@color/text_white_hint"
        android:textSize="13sp"
        android:minWidth="0dp"
        android:minHeight="0dp" />

</LinearLayout>
