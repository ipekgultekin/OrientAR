<?xml version="1.0" encoding="utf-8"?>
<!--
    SCRUM-107 F8: chip has two visual states driven by the chipMyLocation.isSelected flag,
    which mirrors useCurrentLocationAsStart in CampusTourActivity.
    - Selected (active): solid green fill, no stroke — paired with white TextView color via
      chip_text_selector.xml + android:duplicateParentState="true" on the inner TextView.
    - Default (inactive): the original outline aesthetic (5% green bg + 12% green border).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/campus_dot_green" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/campus_chip_green_bg" />
            <stroke android:width="1dp" android:color="@color/campus_chip_green_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
