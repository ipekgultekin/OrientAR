<?xml version="1.0" encoding="utf-8"?>
<!--
    Premium glass card for the F4 calibration overlay. 3-layer pattern mirroring
    Step 2A notification cards but with a neutral 1dp white border (no severity
    color). 18dp corner radius.
    SCRUM-107 Step 2B.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EB1A1A2E"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#33FFFFFF"/>
        </shape>
    </item>
</layer-list>
