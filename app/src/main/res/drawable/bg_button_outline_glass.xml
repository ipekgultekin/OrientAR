<?xml version="1.0" encoding="utf-8"?>
<!--
    SCRUM-107 F6: Recalibrate button — glass-secondary aesthetic.
    rgba(255,255,255,0.075) solid + rgba(255,255,255,0.16) 1px stroke + ripple rgba(255,255,255,0.20).
    Replaces the prior bg_button_outline.xml which used 0.20 solid + 0.40 stroke (too prominent).
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#13FFFFFF" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#29FFFFFF" />
        </shape>
    </item>
</ripple>
