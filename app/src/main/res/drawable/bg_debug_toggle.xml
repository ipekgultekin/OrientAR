<?xml version="1.0" encoding="utf-8"?>
<!--
    SCRUM-107 F10: single-state glass oval. The button is now the AR help-sheet trigger,
    so the previous selector's `state_selected` branch (red #E31837) is unreachable and removed.
    Matches the existing glass aesthetic (rgba(0,0,0,0.4) fill + rgba(255,255,255,0.4) stroke).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#66000000" />
    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
    <size
        android:width="48dp"
        android:height="48dp" />
</shape>
