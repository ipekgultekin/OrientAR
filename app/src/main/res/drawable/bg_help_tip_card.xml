<?xml version="1.0" encoding="utf-8"?>
<!--
    SCRUM-107 F10: subtle inner card surface for the help sheet's 2x2 "Best practices" grid.
    Tone matches the rgba(255,255,255,0.04) suggested in the F10 spec (one notch above the
    bg_glass_card base so the cards read as distinct without competing with the parent surface).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0AFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#14FFFFFF" />
    <corners android:radius="10dp" />
</shape>
