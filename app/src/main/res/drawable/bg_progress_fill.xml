<?xml version="1.0" encoding="utf-8"?>
<!--
    SCRUM-107 F6: progress bar with red_action → red_action_warm horizontal gradient.
    Replaces the prior solid-red progress_red.xml. Background track is 14% white.
    angle=0 means left→right gradient (Android convention: 0=left-right, 90=bottom-top, 180=right-left, 270=top-bottom).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#24FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:startColor="@color/red_action"
                    android:endColor="@color/red_action_warm"
                    android:angle="0"
                    android:type="linear" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
