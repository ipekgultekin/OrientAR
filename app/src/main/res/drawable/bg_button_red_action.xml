<?xml version="1.0" encoding="utf-8"?>
<!--
    SCRUM-107 F6 + polish: End Navigation button — vibrant destructive action.
    red_action (#FF3B47, full opacity) solid + rgba(255,255,255,0.08) 1px stroke
    + ripple rgba(255,255,255,0.18). No box-shadow glow (locked per K2 — XML drawable
    doesn't express glow well, and clean vibrant color reads as "destructive" without ornamentation).
    Renamed from bg_button_red_muted.xml after field test 2026-05-18 — the 78%-alpha muted variant
    looked washed out and lost destructive-action presence.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2EFFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/red_action" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
</ripple>
